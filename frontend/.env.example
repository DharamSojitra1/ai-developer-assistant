# Frontend configuration. Everything prefixed with VITE_ is bundled into the
# public JavaScript, so never put secrets (Groq keys, JWT secrets, API keys) here.

# Base URL of the FastAPI backend. Leave empty to call the same origin
# (the Vite dev proxy in development, or a reverse proxy in production).
# If set to another origin, the backend's FRONTEND_URL must match this app's origin.
VITE_API_BASE_URL=

# Backend the Vite dev server proxies /api requests to (development only).
VITE_DEV_API_TARGET=http://localhost:8000
