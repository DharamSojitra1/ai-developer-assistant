# App
APP_NAME=AI Developer Assistant
APP_ENV=development
DEBUG=false
# Required: the app will not start without it
API_KEY=your-super-secret-api-key-change-this
# Allowed CORS origin for the frontend
FRONTEND_URL=http://localhost:5173

# LLM providers
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b
GEMINI_API_KEY=
# true returns mocked LLM responses (defaults to true when unset)
MOCK_MODE=false
REQUEST_TIMEOUT=30

# Agent (values are validated at startup; out-of-range values stop the app)
# 0.0-2.0; 0 keeps tool selection deterministic
AGENT_TEMPERATURE=0
# 1-32768
AGENT_MAX_TOKENS=500
# 1-20 LLM steps before the agent stops with stop_reason=max_iterations
AGENT_MAX_ITERATIONS=5
# 0-100 previous chat turns sent to the agent as context
AGENT_HISTORY_LIMIT=10
# Max seconds a slow agent tool (e.g. knowledge base search) may run
TOOL_TIMEOUT_SECONDS=30
# Let the model request several tool calls in one step (run concurrently)
AGENT_PARALLEL_TOOL_CALLS=true
# Classify each message and route it to a specialised agent; false always
# uses the general tool agent
AGENT_ROUTING_ENABLED=true
# 1-10 worker hand-offs before the multi-agent supervisor must answer
SUPERVISOR_MAX_ROUNDS=4
# How long agent checkpoints (incl. runs awaiting approval) are kept
AGENT_CHECKPOINT_TTL_SECONDS=604800

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_developer_assistant

# JWT (JWT_SECRET_KEY is required)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAG retrieval
RAG_DISTANCE_THRESHOLD=0.35
RAG_RETRIEVAL_TOP_K=10
RAG_FINAL_TOP_K=3

# Hybrid search: BM25 keyword results fused with vector results (RRF)
RAG_HYBRID_SEARCH=true
RAG_KEYWORD_TOP_K=10
RAG_RRF_K=60

# RAG ingestion (max upload size in bytes; chunk size/overlap in characters)
RAG_MAX_UPLOAD_BYTES=5242880
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Embeddings. Changing the model switches to a new vector collection;
# run `python -m app.scripts.reembed` to fill it.
EMBEDDING_MODEL_NAME=gemini-embedding-001

# Reranker
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
# auto, cpu, or cuda
RERANKER_DEVICE=auto
RERANKER_SCORE_THRESHOLD=0.0

# Request limits: whole request body (bytes, above RAG_MAX_UPLOAD_BYTES),
# chat/agent message length and indexed text length (characters)
MAX_REQUEST_BYTES=6291456
CHAT_MAX_MESSAGE_CHARS=8000
RAG_MAX_TEXT_CHARS=1000000

# Rate limits ("N/second|minute|hour|day"). Per user with a valid access
# token, otherwise per client IP; auth routes are always per IP.
RATE_LIMIT_ENABLED=true
# memory:// is per process; use redis://host:6379 with several workers
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_CHAT=5/minute
RATE_LIMIT_AGENT=10/minute
RATE_LIMIT_RAG=30/minute
RATE_LIMIT_AUTH=5/minute

# Privacy: chat history is deleted after this many days (TTL index);
# tool arguments are logged as lengths only unless set to false
CHAT_HISTORY_RETENTION_DAYS=90
LOG_REDACT_TOOL_ARGS=true

# Production (APP_ENV=production) refuses to start with the example
# secrets above, secrets shorter than 32 characters, or DEBUG=true.
# Inject real secrets as environment variables from a secret store
# (e.g. AWS Secrets Manager / SSM via the ECS task definition).
